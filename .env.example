# Copy this file to .env and update values for your XAMPP MySQL setup
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# XAMPP MySQL — default local settings (change only if you customized XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# This project uses ONE database only (ignore cognitive_performance_db in phpMyAdmin if present)
DB_NAME=cognitive_monitoring_db

# ---------------------------------------------------------------------------
# Brevo transactional email (registration OTP)
# Keep BREVO_API_KEY on the backend only — never put it in frontend JS.
# 1) Create a free Brevo account and verify it
# 2) Settings → SMTP & API → API Keys → Generate API v3 key
# 3) Senders → add/verify your sender email
# 4) Paste values below
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=CogMonitor

# Optional legacy SMTP (inbox + password reset still work without Brevo)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@yourdomain.com
